&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> table_rows = await page.query_selector_all(&amp;#39;//td[@class=&amp;#34;td1&amp;#34;]&amp;#39;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> closed = await table_rows[1].inner_text()
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> if &amp;#34;ZRUŠENA&amp;#34; in closed or &amp;#34;ZRUŠENÁ&amp;#34; in closed:
