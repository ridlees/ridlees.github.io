&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> name_tr = await page.query_selector(&amp;#39;//tr[@id=&amp;#34;Název instituce&amp;#34;]&amp;#39;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> name = &amp;#34;&amp;#34;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> if name_tr:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> tds = await name_tr.query_selector_all(&amp;#34;td&amp;#34;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> if len(tds) &amp;gt; 1:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> name = (await tds[1].inner_text()).strip()
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> address_tr = await page.query_selector(&amp;#39;//tr[@id=&amp;#34;Adresa&amp;#34;]&amp;#39;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> address = &amp;#34;&amp;#34;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> if address_tr:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> tds = await address_tr.query_selector_all(&amp;#34;td&amp;#34;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> if len(tds) &amp;gt; 1:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> address = (await tds[1].inner_text()).strip()
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> print(f&amp;#34;{name}: {address}&amp;#34;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> file.write(f&amp;#34;{name}: {address}\n&amp;#34;)
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> file.flush()
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
